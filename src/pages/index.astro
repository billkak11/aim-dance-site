---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import site from '../data/locations.json';
import home from '../data/home.json';
import { getCollection } from 'astro:content';


const yesterday = new Date(Date.now() - 864e5);


const events = (await getCollection('events'))
  .filter((e) => e.data.date >= yesterday)
  .sort((a,b) => a.data.date.getTime() - b.data.date.getTime())
  .slice(0,2);


const staff = (await getCollection('staff'))
  .sort((a,b) => a.data.order - b.data.order)
  .slice(0,10);



/* =========================================================
   HOMEPAGE GENRES
   ========================================================= */

const genres = home.genres;



/* =========================================================
   HOMEPAGE PROGRAMS
   ========================================================= */

const programs = home.programs.map((program, i) => ({
  ...program,
  number: String(i + 1).padStart(2, '0')
}));
---

<Base title="Art In Motion Dance Center | Melville & Commack, NY">


  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="home-hero video-hero">

    <video
      class="hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      poster={home.hero.poster}
      aria-hidden="true"
    >

      <source
        src="/uploads/client/videos/hero-2.MP4"
        type="video/mp4"
      />

    </video>


    <div class="hero-shade"></div>


    <div class="wrap hero-content">

      <div class="eyebrow light">
        {home.hero.eyebrow}
      </div>

      <h1>
        {home.hero.headline_line1}<br/>
        <em>{home.hero.headline_line2}</em>
      </h1>

      <p>
        {home.hero.text}
      </p>

      <div class="actions">
        <a class="btn" href={home.hero.button1_link}>
          {home.hero.button1_label}
        </a>
        <a class="btn btn-light" href={home.hero.button2_link}>
          {home.hero.button2_label}
        </a>
      </div>

    </div>

    <div class="hero-stat">
      <b>
        {home.hero.stat_title}
      </b>
      <span>
        {home.hero.stat_text}
      </span>
    </div>

  </section>



  <!-- =====================================================
       INTRODUCTION
       ===================================================== -->

  <section class="intro-section">

    <div class="wrap intro-grid">

      <div>
        <div class="eyebrow">
          {home.intro.eyebrow}
        </div>
        <h2>
          {home.intro.headline_line1}<br/>
          {home.intro.headline_line2}
        </h2>
      </div>

      <div class="intro-copy">
        <p>
          {home.intro.paragraph1}
        </p>
        <p>
          {home.intro.paragraph2}
        </p>
        <a class="text-link" href={home.intro.link_url}>
          {home.intro.link_label}
        </a>
      </div>

    </div>
  </section>



  <!-- =====================================================
       IMAGE STORY
       ===================================================== -->

  <section
    class="home-image-story"
    aria-label="Life at AIM"
  >

    <div class="home-image-story-grid">

      {home.story_images.map((img, i) => (
        <figure class={i === 0 ? 'story-wide' : undefined}>
          <img
            src={img.image}
            alt={img.alt}
            loading="lazy"
          />
        </figure>
      ))}

    </div>

  </section>



  <!-- =====================================================
       DANCE GENRES
       ===================================================== -->

  <section class="genre-section">


    <div class="wrap section-head">

      <div>

        <div class="eyebrow light">
          Find your movement
        </div>

        <h2>
          Dance styles at AIM
        </h2>

      </div>


      <a
        class="text-link light-link"
        href="/genres"
      >
        Explore all genres →
      </a>

    </div>



    <div class="genre-grid client-genre-grid home-genre-grid">


      {genres.map((genre, i) => (

        <a
          class="genre-card"
          href={genre.href}
          aria-label={`Explore ${genre.name} at AIM`}
        >

          <img
            class="genre-card-image"
            src={genre.image}
            alt={`${genre.name} dance classes at AIM`}
            loading="lazy"
          />


          <span
            class="genre-card-shade"
            aria-hidden="true"
          ></span>


          <div class="genre-card-copy">

            <span>
              {String(i + 1).padStart(2,'0')}
            </span>

            <h3>
              {genre.name}
            </h3>

          </div>

        </a>

      ))}


    </div>

  </section>



  <!-- =====================================================
       PROGRAMS
       ===================================================== -->

  <section class="program-feature home-programs-section">

    <div class="wrap">


      <div class="home-programs-heading">


        <div>

          <div class="eyebrow">
            Programs for every goal
          </div>


          <h2>
            Find the right path<br/>
            for your dancer.
          </h2>

        </div>



        <div class="home-programs-intro">

          <p>
            From recreational classes and competition training to
            summer programs, kickline, parties and a full range of
            dance genres, AIM offers opportunities for dancers at
            every stage.
          </p>


          <a
            class="text-link"
            href="/programs/"
          >
            Explore all programs →
          </a>

        </div>


      </div>



      <div class="home-program-grid">


        {programs.map((program) => (

          <a
            class="home-program-card"
            href={program.href}
          >

            <div class="home-program-image">

              <img
                src={program.image}
                alt={program.image_alt}
                loading="lazy"
              />

              <span
                class="home-program-image-shade"
                aria-hidden="true"
              ></span>

            </div>


            <div class="home-program-card-body">

              <div class="home-program-card-top">

                <span class="home-program-number">
                  {program.number}
                </span>

                <span
                  class="home-program-arrow"
                  aria-hidden="true"
                >
                  ↗
                </span>

              </div>


              <div class="home-program-card-copy">

                <h3>
                  {program.name}
                </h3>

                <p>
                  {program.description}
                </p>

              </div>


              <span class="home-program-learn">
                Learn more
              </span>

            </div>

          </a>

        ))}


      </div>

    </div>

  </section>



  <!-- =====================================================
       STAFF
       ===================================================== -->

  <section class="home-staff-section">


    <div class="wrap section-head dark">


      <div>

        <div class="eyebrow">
          {home.sections.staff.eyebrow}
        </div>


        <h2>
          {home.sections.staff.headline}
        </h2>

      </div>


      <a
        class="text-link"
        href="/staff"
      >
        {home.sections.staff.link_label}
      </a>


    </div>



    <div class="staff-carousel-shell">


      <div
        class="staff-carousel"
        aria-label="AIM staff carousel"
      >


        {staff.map((s) => (

          <a
            class="home-staff-card"
            href={`/team/${s.id}`}
          >


            <div class="home-staff-photo">


              {s.data.photo
                ? (

                  <img
                    src={s.data.photo}
                    alt={s.data.name}
                    loading="lazy"
                  />

                )
                : (

                  <span>

                    {s.data.name
                      .split(' ')
                      .map((p)=>p[0])
                      .slice(0,2)
                      .join('')}

                  </span>

                )
              }


            </div>


            <div>

              <p>
                {s.data.role}
              </p>

              <h3>
                {s.data.name}
              </h3>

            </div>


          </a>

        ))}


      </div>


    </div>

  </section>



  <!-- =====================================================
       AIM EXPERIENCE
       ===================================================== -->

  <section class="mosaic-section">


    <div class="wrap">


      <div class="section-head dark">


        <div>

          <div class="eyebrow">
            {home.sections.experience.eyebrow}
          </div>


          <h2>
            {home.sections.experience.headline_line1}<br/>
            {home.sections.experience.headline_line2}
          </h2>

        </div>


        <p>
          {home.sections.experience.text}
        </p>


      </div>



      <div class="photo-mosaic">

        {home.experience_photos.map((img) => (
          <figure>
            <img
              src={img.image}
              alt={img.alt}
              loading="lazy"
            />
          </figure>
        ))}

      </div>


    </div>

  </section>



  <!-- =====================================================
       EVENTS
       ===================================================== -->

  <section class="events-section">


    <div class="wrap events-home-grid">


      <div>


        <div class="section-head">


          <div>

            <div class="eyebrow">
              {home.sections.events.eyebrow}
            </div>


            <h2>
              {home.sections.events.headline}
            </h2>

          </div>


          <a
            class="text-link"
            href="/events"
          >
            {home.sections.events.link_label}
          </a>


        </div>



        <div class="events">


          {events.length
            ? events.map(e => <EventCard e={e}/>)
            : <p>{home.sections.events.empty_message}</p>
          }


        </div>


      </div>



      <div class="events-home-photo">


        <img
          src={home.events_photo.image}
          alt={home.events_photo.alt}
          loading="lazy"
        />


        <span>
          {home.sections.events.photo_caption}
        </span>


      </div>


    </div>

  </section>



  <!-- =====================================================
       PAST WORKSHOP RECAPS
       ===================================================== -->

  <section class="masterclass-recaps">


    <div class="wrap">


      <div class="section-head dark masterclass-recap-head">


        <div>

          <div class="eyebrow">
            Past workshop recaps
          </div>


          <h2>
            Experience AIM in motion.
          </h2>

        </div>


        <p>
          Take a look back at special workshops and guest training
          experiences hosted at Art In Motion Dance Center.
        </p>


      </div>



      <div class="masterclass-recap-grid">


        <!-- TRIBE 99 -->

        <article class="masterclass-recap-card">


          <div class="masterclass-video-wrap">


            <video
              controls
              playsinline
              preload="metadata"
              aria-label="Alexandra Lund Tribe 99 Workshop"
            >

              <source
                src="/uploads/drive/videos/tribe-99.mp4"
                type="video/mp4"
              />


              Your browser does not support video playback.

            </video>


          </div>



          <div class="masterclass-recap-copy">


            <span>
              Workshop Recap
            </span>


            <h3>
              Alexandra Lund
            </h3>


            <p>
              Tribe 99 Workshop
            </p>


          </div>


        </article>



        <!-- JONA BIDDLE -->

        <article class="masterclass-recap-card">


          <div class="masterclass-video-wrap">


            <video
              controls
              playsinline
              preload="metadata"
              aria-label="Jona Biddle Hip Hop and Knicks City Kids Workshop"
            >

              <source
                src="/uploads/drive/videos/jona-biddle.mp4"
                type="video/mp4"
              />


              Your browser does not support video playback.

            </video>


          </div>



          <div class="masterclass-recap-copy">


            <span>
              Workshop Recap
            </span>


            <h3>
              Jona Biddle
            </h3>


            <p>
              Hip Hop &amp; Knicks City Kids Workshop
            </p>


          </div>


        </article>


      </div>


    </div>

  </section>



  <!-- =====================================================
       ELFSIGHT PLATFORM
       Loaded once for Instagram + Google Reviews
       ===================================================== -->

  <script
    is:inline
    src="https://elfsightcdn.com/platform.js"
    async
  ></script>



  <!-- =====================================================
       INSTAGRAM
       ===================================================== -->

  <section class="instagram-section">


    <div class="wrap">


      <div class="section-head dark instagram-head">


        <div>

          <div class="eyebrow">
            {home.sections.instagram.eyebrow}
          </div>


          <h2>
            {home.sections.instagram.headline}
          </h2>

        </div>


        <a
          class="text-link"
          href="https://www.instagram.com/artinmotiondance/"
          target="_blank"
          rel="noopener noreferrer"
        >
          @artinmotiondance ↗
        </a>


      </div>



      <div
        class="elfsight-app-740938a5-67b1-4bdb-a14d-9dd23a75f4c0"
        data-elfsight-app-lazy
      ></div>



      <div class="instagram-cta">


        <div>

          <strong>
            {home.sections.instagram.cta_title}
          </strong>


          <span>
            {home.sections.instagram.cta_text}
          </span>

        </div>


        <a
          class="btn"
          href="https://www.instagram.com/artinmotiondance/"
          target="_blank"
          rel="noopener noreferrer"
        >
          {home.sections.instagram.button_label}
        </a>


      </div>


    </div>

  </section>







  <!-- =====================================================
       LOCATIONS
       ===================================================== -->

  <section class="locations-section">


    <div class="wrap">


      <div class="eyebrow light">
        {home.sections.locations.eyebrow}
      </div>


      <h2>
        {home.sections.locations.headline}
      </h2>



      <div class="location-grid">


        {site.locations.map((l,i) => (


          <article class="location-card location-card-photo">


            <img
              class="location-bg"
              src={home.studio_photos[l.name.toLowerCase()]}
              alt={`${l.name} AIM Dance studio`}
              loading="lazy"
            />


            <div class="location-overlay"></div>



            <div class="location-content">


              <span class="location-number">
                0{i+1}
              </span>


              <h3>
                {l.name}
              </h3>


              <p>
                {l.address}
              </p>


              <p class="location-phone">

                <a href={`tel:${l.phone.replace(/\D/g,'')}`}>
                  {l.phone}
                </a>

              </p>



              <div class="location-actions">


                <a
                  class="btn btn-light"
                  href={l.portal}
                >
                  Register / Portal
                </a>


                <a
                  class="text-link light-link"
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(l.address)}`}
                >
                  Directions ↗
                </a>


              </div>


            </div>


          </article>


        ))}


      </div>


    </div>

  </section>



  <!-- =====================================================
       FINAL CTA
       ===================================================== -->

  <section class="final-cta">


    <div class="wrap">


      <div>


        <div class="eyebrow">
          {home.sections.final_cta.eyebrow}
        </div>


        <h2>
          {home.sections.final_cta.headline}
        </h2>


      </div>



      <div class="actions">


        {site.locations.map(l => (


          <a
            class="btn"
            href={l.portal}
          >
            Register in {l.name}
          </a>


        ))}


      </div>


    </div>

  </section>

</Base>
