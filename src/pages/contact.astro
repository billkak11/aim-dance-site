---
import Base from '../layouts/Base.astro';
import pageText from '../data/page-text.json';
import site from '../data/locations.json';

const melville =
  site.locations.find((location) =>
    location.name.toLowerCase().includes('melville')
  );

const splitAddress = (address = '') => {
  const i = address.indexOf(',');
  return i === -1
    ? [address, '']
    : [address.slice(0, i + 1), address.slice(i + 1).trim()];
};

const commack =
  site.locations.find((location) =>
    location.name.toLowerCase().includes('commack')
  );
---

<Base
  title="Contact | Art In Motion Dance Center"
  description="Contact Art In Motion Dance Center in Melville or Commack, New York. Ask about classes, registration, programs, events and dance training."
>

  <!-- =====================================================
       HERO
       ===================================================== -->

  <section class="aim-contact-hero">

    <div
      class="aim-contact-hero-mark"
      aria-hidden="true"
    >
      AIM
    </div>

    <div class="wrap aim-contact-hero-inner">

      <div>

        <div class="eyebrow light">
          {pageText.contact.hero_eyebrow}
        </div>

        <h1>
          {pageText.contact.hero_title}
        </h1>

        <p>
          {pageText.contact.hero_text}
        </p>

      </div>

    </div>

  </section>



  <!-- =====================================================
       CONTACT CONTENT
       ===================================================== -->

  <section class="aim-contact-main">

    <div class="wrap">

      <div class="aim-contact-heading">

        <div>

          <div class="eyebrow">
            {pageText.contact.heading_eyebrow}
          </div>

          <h2>
            {pageText.contact.heading_title}
          </h2>

        </div>

        <p>
          {pageText.contact.heading_text}
        </p>

      </div>



      <div class="aim-contact-layout">


        <!-- =================================================
             LEFT COLUMN
             ================================================= -->

        <aside class="aim-contact-locations">


          <!-- MELVILLE -->

          <article class="aim-location-card">

            <div class="aim-location-number">
              01
            </div>

            <div class="aim-location-card-content">

              <div class="eyebrow">
                Melville Center
              </div>

              <h3>
                Melville
              </h3>

              <div class="aim-location-details">

                <p>
                  {splitAddress(melville?.address)[0]}<br/>
                  {splitAddress(melville?.address)[1]}
                </p>

                <a href={`tel:${(melville?.phone ?? '').replace(/\D/g, '')}`}>
                  {melville?.phone}
                </a>

                <a href={`mailto:${melville?.email}`}>
                  {melville?.email}
                </a>

              </div>


              <div class="aim-location-actions">

                {melville?.portal && (

                  <a
                    class="btn"
                    href={melville.portal}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Parent Portal ↗
                  </a>

                )}

                <a
                  class="aim-direction-link"
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(melville?.address ?? '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Directions ↗
                </a>

              </div>

            </div>

          </article>



          <!-- COMMACK -->

          <article class="aim-location-card">

            <div class="aim-location-number">
              02
            </div>

            <div class="aim-location-card-content">

              <div class="eyebrow">
                Commack Center
              </div>

              <h3>
                Commack
              </h3>

              <div class="aim-location-details">

                <p>
                  {splitAddress(commack?.address)[0]}<br/>
                  {splitAddress(commack?.address)[1]}
                </p>

                <a href={`tel:${(commack?.phone ?? '').replace(/\D/g, '')}`}>
                  {commack?.phone}
                </a>

                <a href={`mailto:${commack?.email}`}>
                  {commack?.email}
                </a>

              </div>


              <div class="aim-location-actions">

                {commack?.portal && (

                  <a
                    class="btn"
                    href={commack.portal}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    Parent Portal ↗
                  </a>

                )}

                <a
                  class="aim-direction-link"
                  href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(commack?.address ?? '')}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Directions ↗
                </a>

              </div>

            </div>

          </article>



          <!-- SMALL HELP BLOCK -->

          <div class="aim-contact-help">

            <span>
              {pageText.contact.help_title}
            </span>

            <p>
              {pageText.contact.help_text}
            </p>

          </div>

        </aside>



        <!-- =================================================
             RIGHT COLUMN / JOTFORM
             ================================================= -->

        <div class="aim-contact-form-column">

          <div class="aim-contact-form-top">

            <span>
              {pageText.contact.form_label}
            </span>

            <h3>
              {pageText.contact.form_title}
            </h3>

            <p>
              {pageText.contact.form_text}
            </p>

          </div>


<div class="aim-jotform-shell">

<script
  is:inline
  type="text/javascript"
  src="https://form.jotform.com/jsform/262806894833167"
></script>

</div>

        </div>


      </div>

    </div>

  </section>



  <!-- =====================================================
       FINAL CTA
       ===================================================== -->

  <section class="aim-contact-cta">

    <div class="wrap aim-contact-cta-inner">

      <div>

        <div class="eyebrow light">
          {pageText.contact.cta_eyebrow}
        </div>

        <h2>
          {pageText.contact.cta_headline}
        </h2>

      </div>


      <a
        class="btn btn-light"
        href="/schedules"
      >
        View schedules
      </a>

    </div>

  </section>


</Base>
