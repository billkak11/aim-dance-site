---
import Base from '../layouts/Base.astro';
import genreData from '../data/genres.json';

const genreCards = genreData.genres.map((g) => ({
  name: g.name,
  image: g.image,
  href: `/genres/${g.slug}/`,
  description: g.card_description
}));
---

<Base
  title="Dance Genres | AIM Dance"
  description="Explore the dance styles offered at Art In Motion Dance Center."
>

  <!-- =========================================
       HERO
       ========================================= -->

  <section class="genres-showcase-hero">

    <div class="wrap">

      <div class="eyebrow light">
        {genreData.page.hero_eyebrow}
      </div>

      <h1>
        {genreData.page.hero_title}
      </h1>

      <p>
        {genreData.page.hero_text}
      </p>

    </div>

  </section>



  <!-- =========================================
       GENRE CARDS
       ========================================= -->

  <section class="genres-showcase">

    <div class="wrap">


      <div class="genres-showcase-intro">

        <div>

          <div class="eyebrow">
            {genreData.page.intro_eyebrow}
          </div>

          <h2>
            {genreData.page.intro_headline}
          </h2>

        </div>


        <p>
          {genreData.page.intro_text}
        </p>

      </div>



      <div class="genres-showcase-grid">

        {genreCards.map((genre, index) => (

          <a
            class="genre-showcase-card"
            href={genre.href}
            aria-label={`Learn more about ${genre.name}`}
          >

            <img
              src={genre.image}
              alt={`${genre.name} classes at Art In Motion Dance Center`}
              loading="lazy"
            />


            <div
              class="genre-showcase-overlay"
              aria-hidden="true"
            ></div>


            <div class="genre-showcase-content">

              <span class="genre-showcase-number">
                {String(index + 1).padStart(2, '0')}
              </span>


              <h2>
                {genre.name}
              </h2>


              <div class="genre-showcase-description">

                <p>
                  {genre.description}
                </p>

              </div>

            </div>

          </a>

        ))}

      </div>


    </div>

  </section>



  <!-- =========================================
       FINAL CTA
       ========================================= -->

  <section class="page-cta-band">

    <div class="wrap">

      <div>

        <div class="eyebrow light">
          {genreData.page.cta_eyebrow}
        </div>

        <h2>
          {genreData.page.cta_headline}
        </h2>

      </div>


      <div class="actions">

        <a
          class="btn btn-light"
          href="/schedules"
        >
          View schedules
        </a>


        <a
          class="btn outline staff-cta-outline"
          href="/contact"
        >
          Contact us
        </a>

      </div>

    </div>

  </section>

</Base>
