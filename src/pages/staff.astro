/* =========================================================
   STAFF DATA
   ========================================================= */

const priorityIds = [
  'siobhan-santapaola',
  'ali-ribellino',
  'victoria-rosa',
  'lisa-santapaola',
  'athena-castiglione'
];

const priorityOrder = new Map(
  priorityIds.map((id, index) => [id, index])
);


const staff = (await getCollection('staff'))
  .filter((s) => s.id !== 'donna-floridia')
  .sort((a, b) => {

    const aPriority = priorityOrder.get(a.id);
    const bPriority = priorityOrder.get(b.id);

    if (aPriority !== undefined && bPriority !== undefined) {
      return aPriority - bPriority;
    }

    if (aPriority !== undefined) return -1;
    if (bPriority !== undefined) return 1;

    return a.data.order - b.data.order;

  });
